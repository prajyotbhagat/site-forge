{% import "v2/sections.html.j2" as S with context %}<!doctype html>
<html lang="{{ site.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="theme-color" content="{{ theme.primary }}">
<title>{{ page.meta.title }}</title>
<meta name="description" content="{{ page.meta.description }}">
<meta property="og:title" content="{{ page.meta.title }}">
<meta property="og:description" content="{{ page.meta.description }}">
<meta name="sf-site" content="{{ site.slug }}">
{% for f in preload_fonts %}<link rel="preload" href="assets/fonts/{{ f }}" as="font" type="font/woff2" crossorigin>
{% endfor %}<link rel="stylesheet" href="assets/site.css">
<script src="assets/site.js" defer></script>
{% if page.slug == 'index' %}<script type="application/ld+json">{{ schema_json|safe }}</script>{% endif %}
</head>
<body class="t-{{ theme.id }} d-{{ theme.density }} b-{{ theme.button }} sh-{{ theme.shadow }}">
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="index.html">{% if site.logo_src %}<img src="{{ site.logo_src }}" alt="{{ site.name }}" height="40">{% else %}<span class="mark" aria-hidden="true">{{ site.initials }}</span><span class="brand-name">{{ site.name }}</span>{% endif %}</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">{{ icon('menu') }}<span class="sr">Menu</span></button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>{% for item in site.nav %}<li><a href="{{ item.href }}"{% if item.page == page.slug %} aria-current="page"{% endif %}>{{ item.label }}</a></li>{% endfor %}</ul>
      {{ S.btn(site.cta, "btn-primary", "btn-nav") }}
    </nav>
  </div>
</header>
<main id="main">
{% for s in page.sections %}{{ S.render(s, page.slug) }}{% endfor %}
</main>
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand"><p class="footer-name">{{ site.name }}</p>{% if site.area %}<p>{{ icon('pin', 'ic ic-sm') }}{{ site.area }}</p>{% endif %}{% if site.hours %}<p>{{ icon('clock', 'ic ic-sm') }}{{ site.hours }}</p>{% endif %}</div>
    <div>{% if site.phone %}<p class="footer-label">Call</p><p><a class="footer-phone" href="tel:{{ site.phone_tel }}" data-event="call_click">{{ site.phone }}</a></p>{% endif %}</div>
    <ul class="footer-links">{% for item in site.nav %}<li><a href="{{ item.href }}">{{ item.label }}</a></li>{% endfor %}{% if site.form %}<li><a href="privacy.html">Privacy notice</a></li>{% endif %}</ul>
  </div>
  <p class="wrap fineprint">© {{ site.name }}</p>
</footer>
{% if site.phone and site.sticky_call %}<a class="sticky-call" href="tel:{{ site.phone_tel }}" data-event="call_click">{{ icon('phone', 'ic ic-sm') }}<span>Call {{ site.phone }}</span></a>{% endif %}
</body>
</html>
